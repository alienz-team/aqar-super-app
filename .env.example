# Copy to .env and fill in. All values come from your Supabase project dashboard.

# --- Database (Prisma) ----------------------------------------------------------
# Connect > ORMs > Prisma. Pooled connection (port 6543) for the app; pgbouncer=true
# turns off prepared statements, which the transaction pooler does not support.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct/session connection (port 5432) used by `prisma db push`.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Supabase Auth (safe to expose: sent to the browser) -------------------------
# Project Settings > API Keys. Use the publishable key (sb_publishable_...).
# Never put the secret / service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Older projects can use the legacy anon key instead of the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Public origin used in confirmation-email links. Must also be listed in Supabase:
# Authentication > URL Configuration (Site URL and Redirect URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- One-time setup -------------------------------------------------------------
# 1. npm run db:push     create the tables
# 2. npm run db:secure   enable RLS and revoke Data API access on them (re-run after new tables)
# 3. Authentication > Email Templates > Confirm signup: point the link at
#    {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=email
#    (confirmed users land on /account).
# 4. Sign up on the site, then promote yourself to admin in the SQL editor:
#    update "User" set role = 'ADMIN' where email = 'you@example.com';
